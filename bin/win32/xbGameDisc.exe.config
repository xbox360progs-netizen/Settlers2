<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="ContentPanelMappings" type="xbGameDisc.ConfigSections.ContentPanelMappingSection, xbGameDisc"/>
  </configSections>

  <ContentPanelMappings>
    <PanelMappings>
      <add nodeType="Files" panel="FilePanel" label="Files"/>
      <add nodeType="Layer" panel="LayerPanel" label="Layer"/>
      <add nodeType="Rules" panel="RulePanel" label="Rules"/>
      <add nodeType="Warnings" panel="WarningPanel" label="Warnings"/>
    </PanelMappings>
  </ContentPanelMappings>

</configuration>