;
; XSidecar.inf - Install the USB user-mode driver
;                for the Xbox 360 Development\Test
;                Kit Sidecar
;

[Version]
Signature="$Windows NT$"
Class=USB
ClassGUID={36FC9E60-C465-11CF-8056-444553540000}
Provider=%MSFT%
DriverVer=02/28/2011,2.0.20650.0
CatalogFile=Xsidecar.cat


[Manufacturer]
%MSFT%=Microsoft,NTamd64

[Microsoft.NTamd64]
%XSidecarRubyEmulationDeviceName%=SidecarRubyEmulation_Install, USB\VID_045E&PID_028B&REV_0200
%XSidecarEmulationDeviceName%=SidecarEmulation_Install, USB\VID_045E&PID_028B
%XSidecarPerfPipeDeviceName%=SidecarPerfPipe_Install, USB\VID_045E&PID_0290


[ClassInstall32]
AddReg=XSidecarClass_RegistryAdd

[XSidecarClass_RegistryAdd]
HKR,,,,%ClassName%
HKR,,Icon,,"-10"

[SourceDisksFiles]
XSidecarUMDF.dll=1
WudfUpdate_01009.dll=1
WdfCoInstaller01009.dll=1
WinUSBCoInstaller.dll=1


[SourceDisksNames]
1 = %MediaDescription%

; =================== Emulation Device ====================================

[SidecarEmulation_Install.NT]
CopyFiles=UMDriverCopy
Include=WINUSB.INF                      ; Import sections from WINUSB.INF
Needs=WINUSB.NT                         ; Run the CopyFiles & AddReg directives for WinUsb.INF

[SidecarEmulation_Install.NT.hw]
AddReg=XSidecar_Device_AddReg

[SidecarEmulation_Install.NT.Services]
AddService=WinUsb,0x000001f8,WinUsb_ServiceInstall  ; this service is installed because its a filter.
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall  ; flag 0x2 sets this as the service for the device

[SidecarEmulation_Install.NT.CoInstallers]
AddReg=CoInstallers_AddReg
CopyFiles=CoInstallers_CopyFiles

[SidecarEmulation_Install.NT.Wdf]
KmdfService=WINUSB, WinUsb_Install
UmdfDispatcher=WinUsb
UmdfService=UMDF_XSidecarEmulation, UMDF_XSidecarEmulation_Install
UmdfServiceOrder=UMDF_XSidecarEmulation

[UMDF_XSidecarEmulation_Install]
UmdfLibraryVersion=1.9.0
DriverCLSID = "{ED05FE76-5B21-4165-AE55-344FEA532ADA}"
ServiceBinary = "%12%\UMDF\XSidecarUMDF.dll"


; =================== Ruby Emulation Device ====================================

[SidecarRubyEmulation_Install.NT]
CopyFiles=UMDriverCopy
Include=WINUSB.INF                      ; Import sections from WINUSB.INF
Needs=WINUSB.NT                         ; Run the CopyFiles & AddReg directives for WinUsb.INF

[SidecarRubyEmulation_Install.NT.hw]
AddReg=XSidecar_Device_AddReg

[SidecarRubyEmulation_Install.NT.Services]
AddService=WinUsb,0x000001f8,WinUsb_ServiceInstall  ; this service is installed because its a filter.
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall  ; flag 0x2 sets this as the service for the device

[SidecarRubyEmulation_Install.NT.CoInstallers]
AddReg=CoInstallers_AddReg
CopyFiles=CoInstallers_CopyFiles

[SidecarRubyEmulation_Install.NT.Wdf]
KmdfService=WINUSB, WinUsb_Install
UmdfDispatcher=WinUsb
UmdfService=UMDF_XSidecarRubyEmulation, UMDF_XSidecarRubyEmulation_Install
UmdfServiceOrder=UMDF_XSidecarRubyEmulation

[UMDF_XSidecarRubyEmulation_Install]
UmdfLibraryVersion=1.9.0
DriverCLSID = "{89FEDEA7-87EC-4a60-A327-DF2D09AD7B02}"
ServiceBinary = "%12%\UMDF\XSidecarUMDF.dll"

; =================== Performance Pipe Device ====================================

[SidecarPerfPipe_Install.NT]
CopyFiles=UMDriverCopy
Include=WINUSB.INF                      ; Import sections from WINUSB.INF
Needs=WINUSB.NT                         ; Run the CopyFiles & AddReg directives for WinUsb.INF

[SidecarPerfPipe_Install.NT.hw]
AddReg=XSidecar_Device_AddReg

[SidecarPerfPipe_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall  ; flag 0x2 sets this as the service for the device
AddService=WinUsb,0x000001f8,WinUsb_ServiceInstall  ; this service is installed because its a filter.

[SidecarPerfPipe_Install.NT.CoInstallers]
AddReg=CoInstallers_AddReg
CopyFiles=CoInstallers_CopyFiles

[SidecarPerfPipe_Install.NT.Wdf]
KmdfService=WINUSB, WinUsb_Install
UmdfDispatcher=WinUsb
UmdfService=UMDF_XSidecarPerfPipe, UMDF_XSidecarPerfPipe_Install
UmdfServiceOrder=UMDF_XSidecarPerfPipe

[UMDF_XSidecarPerfPipe_Install]
UmdfLibraryVersion=1.9.0
DriverCLSID = "{73264264-2E48-402e-BC84-B78AC81DE2D9}"
ServiceBinary = "%12%\UMDF\XSidecarUMDF.dll"


; =================== UMDF and WinUSB =================================================
[WinUsb_Install]
KmdfLibraryVersion = 1.9

[XSidecar_Device_AddReg]
HKR,,"LowerFilters",0x00010008,"WinUsb" ; FLG_ADDREG_TYPE_MULTI_SZ | FLG_ADDREG_APPEND

[WUDFRD_ServiceInstall]
DisplayName = %WudfRdDisplayName%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\WUDFRd.sys
LoadOrderGroup = Base

[WinUsb_ServiceInstall]
DisplayName     = %WinUsb_SvcDesc%
ServiceType     = 1
StartType       = 3
ErrorControl    = 1
ServiceBinary   = %12%\WinUSB.sys

[CoInstallers_AddReg]
HKR,,CoInstallers32,0x00010000,"WudfUpdate_01009.dll", "WinUsbCoInstaller.dll", "WdfCoInstaller01009.dll,WdfCoInstaller"

[CoInstallers_CopyFiles]
WudfUpdate_01009.dll
WdfCoInstaller01009.dll
WinUsbCoinstaller.dll

[DestinationDirs]
CoInstallers_CopyFiles=11    ; copy to system32
UMDriverCopy=12,UMDF ; copy to drivers/umdf

[UMDriverCopy]
XSidecarUMDF.dll

; =================== Generic ==================================

[Strings]

MSFT="Microsoft Corporation"
MediaDescription="Microsoft Xbox 360 SDK"
ClassName="Xbox 360 Development\Test Kit Sidecar"
XSidecarEmulationDeviceName="Xbox 360 Development\Test Kit (DVD EMU port)"
XSidecarRubyEmulationDeviceName="Xbox 360 S Development Kit"
XSidecarPerfPipeDeviceName="Xbox 360 Develpoment\Test Kit (PIX port)"
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"
WinUsb_SvcDesc="WinUSB Driver"

